# Database
DB_URL=jdbc:mysql://localhost:3306/skill_job_search_app?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTCDB_USERNAME=root
DB_PASSWORD=CHANGE_ME

# Security - use a cryptographically random secret of at least 32 bytes
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_BYTES
JWT_EXPIRATION_MS=86400000

# Seed data: set false after provisioning for production
SEED_DATA=false
ADMIN_EMAIL=admin@your-local-domain.test
ADMIN_PASSWORD=CHANGE_THIS_BEFORE_FIRST_RUN

# Optional SMTP notifications
MAIL_ENABLED=false
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-reply@skilljobs.local

# File uploads
UPLOAD_DIR=uploads
